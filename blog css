*{
   margin: 0;
    padding: 0;
    outline: 0;
    border: 0;
    text-decoration: none;
    list-style: none;
    box-sizing: border-box;

    font-family: "prompt", sans-serif;
    font-style: normal;
}


nav{
width: 100%;


height: 5rem;
background-color: #fff;
display: flex;
justify-content: center;
box-shadow: rgba(0, 0, 0, 0187);
position: fixed;
z-index: 1000;}


.mother_nav{
    width: 90%;
    height: auto;
    padding-left: 0rem;
    padding-right: 0rem;

    display: flex;
    align-items: center;
    justify-content: space-between;
}

.name h2{

    font-size: 30px;
    font-weight: 500;
}


.tag ul{
    display: none;
    
}



.profile{
    display: flex;
    align-items: center;
    gap: 1rem;
}

.person{
     display: none;
}

.blog{
     display: none;
}
.sign_up{
    width: 8rem;
    height: 3rem;
    border-radius: 30px;
    background-color: black;
    display: flex;
    justify-content: center;
    align-items: center;
}

.sign_up a{
    color: #fff;

}



.background{
    width: 100%;
    height: auto;
    
    display: flex;
    justify-content: center;

}


.mother_background{
    width: 90%;
    height: auto;
    background-color: transparent;

    display: grid;
    row-gap: 1rem;
    
}

.text_background{
    width: 100%;
    height: auto;
    background-color: transparent;

    padding-top: 8rem;
}
.text_background h2{
    font-size: 36px;
    font-weight: 500;
}

.text_background button{
    background-color: black;
    height: 3rem;
    width: 12rem;
    border-radius: 30px;

    margin-top: 1rem;

}


.text_background a{

    color: #fff;
}


.box_background{

    width: 100%;
    height: auto;
    background-color: transparent;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0rem;


}
.box_larger{
    width: 48%;
    height: 23rem;
    background-color: #cccccc41;
    border-radius: 30px;
}

.minor_box{
    width: 45%;
    height: 23rem;
    background-color: transparent;
    display: grid;
    row-gap: 1rem;
}

.box1{
    width: 100%;
    height: 100%;
    border-radius: 30px;
    background-color: #cccccc41;
}

.box2{
    width: 100%;
    height: 95%;
    border-radius: 30px;
    background-color: #cccccc41;
    
}



.hero_section{
    width: 100%;
    height: auto;
    display: flex;
    justify-content: center;
    margin-top: 6rem;
}

.hero_mother{
    width: 90%;
    height: auto;

}

.des h2{
    font-size: 30px;
    font-weight: 500;
}

.tabs{
    width: 100%;
    height: auto;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    place-items:center ;
    margin-top: 1rem;
    row-gap: 1rem;
    cursor: pointer;
}

.sub_tabs{
    width: 90%;
    height: 3rem;
    background-color: #fff;
    border-radius: 30px;
    border: solid #00000065 1.5px;
    font-size: 14px;
    display: flex;
    justify-content: center;
    align-items: center;
}


.hero_box{
    width: 100%;
    margin-top: 1rem;
    display: flex;
    justify-content: center;
}

.mother_box{
    width: 100%;
    height: auto;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    place-items: center;
    row-gap: 1rem;

}

.hero_box_mini{
    width: 94%;

    height: 18rem;
    border-radius: 20px;
    background-color: #cccccc41;
}


.latest{
    width: 100%;
    height: auto;
    display: flex;
    justify-content: center;
    margin-top: 3rem;
}

.mother_latest{
    width: 90%;
    height: auto;
    background-color: transparent;
}

.recom{
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.recom h2{
    font-size: 20px;
    font-weight: 500;
}

.recom button{
    width: 8rem;
    height: 3rem;
    border: solid 1.5px #000;
    border-radius: 30px;
    background-color: transparent;
    cursor: pointer;
    font-size: 12.5px;
}

.div_latest{
    width: 100%;
    display: grid;
    row-gap: 1rem;
    margin-top: 2rem;
}
.comp_latest{
    width: 100%;
    height: auto;
    background-color: transparent;
}
.image_block{
    width: 100%;
    height: 17rem;
    background-color: #cccccc41;
    border-radius: 30px;
}
.text_bloc article{
    font-weight: 500;
    font-size: 19px;
    margin-top: 1rem;
}
.text_block p{
    font-size: 14px;
    font-weight: 400;
    margin-top: 1rem;
}


.latest_recent{
    width: 100%;
    height: auto;
    background-color: transparent;
    display: grid;
    row-gap: 1rem;
}

.div_box{
    width: 100%;
    height: auto;
    display: flex;
    align-items: start;
    justify-content: space-between;
}

.box_create{
    width: 44%;
    background-color: #cccccc41;
    height: 8rem;
    border-radius: 30px;
}

.box_text{
    width: 50%;
}

.box_text h4{
    font-size: 15px;
    font-weight: 600;
}

.box_text p{
    margin-top: 1rem;
    font-size: 12px;
    font-weight: 400;
}


.trekker_text{
    width: 100%;
    display: flex;
    justify-content:center; 
    margin-top: 2rem;
    
}

.mother_text{
    width: 90%;
   
}

.trekker_trek h2{
    font-size: 20px;
    font-weight: 500
}

.trekker{
    width: 100%;
    height: auto;
    display: flex;
   justify-content: center;
    
}

.mother_trekker{
    width: 90%;
    height: auto;
    align-items: center;
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    row-gap: 1rem;
    justify-content: space-between;
}

.text_trek{
  width: 100%;
  align-self: flex-start;
  height: auto;
  background-color: transparent;
}

.text_profile{
    display: flex;
    align-items: center;
    gap: 1rem;
}

.profile_text h3{
    font-weight: 500;
}

.profile_article article{
    margin-top: 1rem;
    font-size: 15px;
    font-weight: 400;
    
}




.image_trekker{
    width: 5rem;
    height: 5rem;
    border-radius: 100%;
    background-color: #cccccc41;
}




.video_trek{
    width: 100%;
    height: 20rem;
    background-color: transparent;
    display: flex;
    justify-content: space-between;
    align-self: flex-start;
}


.bigger_trekker{
    width: 54%;
    height: 18rem;
    background-color: #cccccc41;
    border-radius: 12px;
}

.smaller_trekker{
    width: 43%;
    height: 12rem;
    background-color: #cccccc41;
    border-radius: 12px;
}
.banner{
    width: 100%;
    background-color: #ccccccfd;
    height: 17rem;
    margin-top: 3rem;
    justify-content: center;
    display: flex;
    place-items: center;

}

.mother_banner{
    width: 90%;
    height: 13rem;
    background-color: transparent;

}

.inspiration{
    width: 100%;
    height: auto;
    text-align: center;
    font-size: 20px;
    font-weight: 400;
}

#form{
    width: 100%;
    display: flex;
    justify-content: center;
    place-items: center;
    margin-top: 1rem;
    gap: 1rem;
}


#form input{
    width: 45%;
    height: 3rem;
    background-color: white;
    border-radius: 30px;
    color: #000;
    font-size: 8px;
    text-align: center;

    
}


#form input::placeholder{
    color: #000;
}
#form button{
    width: 25%;
    height: 3rem;
    background-color: #000;
    border-radius: 30px;
    color: #fff;
    font-size: 5px;
}












                             
